# ==========================================
# ABG Guard - Bot Tokens
# ==========================================

# ربات اصلی گارد (@abgguardbot): مدیریت پیام‌های متنی، قفل‌ها، پنل و لاگ ادمین
MASTER_BOT_TOKEN=123456789:AA...

# ربات کمکی: دریافت عکس/ویدیو، ارتباط با آنتی‌پورن محلی و جمع‌آوری دیتاست
WORKER_BOT_TOKEN=987654321:BB...

# ==========================================
# Hierarchy & RBAC Settings
# ==========================================

# آیدی عددی (User ID) شما به عنوان خدای ادمین‌ها (Level 3)
# چند نفر؟ با کاما جدا کنید: GOD_ADMIN_IDS=111,222
GOD_ADMIN_ID=000000000

# ==========================================
# Database Connections (PostgreSQL & Redis)
# ==========================================
# داخل docker-compose هاست‌ها db و redis هستند؛
# برای اجرای محلی (python run.py بیرون از کانتینر) برابر 127.0.0.1 بگذارید.
POSTGRES_USER=abg_user
POSTGRES_PASSWORD=abg_secure_password
POSTGRES_DB=abgguard_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# ------------------------------------------
# (جایگزین) اگر ترجیح می‌دهید DSN کامل بدهید:
# POSTGRES_DSN=postgres://abg_user:abg_secure_password@db:5432/abgguard_db
# REDIS_DSN=redis://redis:6379/0
# ------------------------------------------

# ==========================================
# Local AI anti-porn microservice (loopback only)
# ==========================================
PORN_API_URL=http://pornscan:8010/detect
PORN_API_TIMEOUT=6.0
PORN_THRESHOLD=0.55

# ==========================================
# Dataset harvester
# ==========================================
DATASET_DIR=./dataset
DATASET_FILE=./data/genz_corpus.jsonl
DATASET_MAX_BYTES=52428800
DATASET_FLUSH_INTERVAL=2.0

# ==========================================
# Anti flood
# ==========================================
FLOOD_TEXT_LIMIT=5
FLOOD_TEXT_WINDOW=3
FLOOD_JOIN_LIMIT=100
FLOOD_JOIN_WINDOW=60
JOIN_LOCK_SECONDS=60
JOIN_SLOW_MODE=30

# ==========================================
# Private-chat (PV) dashboard  - Master Bot only
# ==========================================
# آدرس وب‌اپ داشبورد گرافیکی (اختیاری). اگر خالی باشد، دکمه وب‌اپ نمایش داده نمی‌شود.
DASHBOARD_WEBAPP_URL=
# لینک کانال پشتیبانی (اختیاری) - دکمه «کانال پشتیبانی» در منوی کاربران
SUPPORT_CHANNEL_URL=
# مهلت (ثانیه) تایید کپچای عضویت برای اعضای جدید
CAPTCHA_TIMEOUT=60
# تاخیر (ثانیه) بین پیام‌های اطلاع‌رسانی همگانی گاد ادمین
BROADCAST_DELAY=0.05

# ==========================================
# Local Telegram Bot API server
# ==========================================
# Local Bot API server (--local mode) removes the cloud 48-hour deletion limit
# and is required for deep purges. Set to "off" to use the cloud API.
TELEGRAM_BOT_API_URL=http://127.0.0.1:8081
# Container path reported by getFile -> host bind mount used to read media.
TELEGRAM_BOT_API_SERVER_DIR=/var/lib/telegram-bot-api
TELEGRAM_BOT_API_DATA_DIR=/opt/dailydev-telegram-bot/telegram-bot-api-data

# ==========================================
# Runtime
# ==========================================
RUN_MODE=polling
WEBHOOK_HOST=
WEBHOOK_PATH_MASTER=/tg/master
WEBHOOK_PATH_WORKER=/tg/worker
WEBHOOK_PORT=8443
LOG_LEVEL=INFO
